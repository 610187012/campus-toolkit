{
  "name": "campus-toolkit",
  "version": "1.0.0",
  "description": "整合校園資訊、選課、公告、社團等功能的綜合性校園工具平台。",
  "private": true,
  "scripts": {
    "predev": "node scripts/materialize-modules.mjs && node scripts/build-module-sandbox.mjs && node scripts/build-module-registry.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/materialize-modules.mjs && node scripts/build-module-sandbox.mjs && node scripts/build-module-registry.mjs",
    "build": "next build",
    "start": "next start",
    "prelint": "node scripts/materialize-modules.mjs && node scripts/build-module-sandbox.mjs && node scripts/build-module-registry.mjs",
    "lint": "eslint . && tsc --noEmit",
    "pretypecheck": "node scripts/materialize-modules.mjs && node scripts/build-module-sandbox.mjs && node scripts/build-module-registry.mjs",
    "typecheck": "tsc --noEmit",
    "module:scan": "node scripts/materialize-modules.mjs && node scripts/build-module-registry.mjs",
    "module:materialize": "node scripts/materialize-modules.mjs",
    "module:sandbox-build": "node scripts/build-module-sandbox.mjs",
    "module:materialize-test": "node scripts/test-materialize-modules.mjs",
    "module:capability-test": "node scripts/test-module-capability-scan.mjs",
    "module:install": "node scripts/module-cli.mjs install",
    "module:link": "node scripts/module-cli.mjs link",
    "module:uninstall": "node scripts/module-cli.mjs uninstall",
    "module:check": "node scripts/module-check.mjs",
    "module:contract-test": "node scripts/test-module-contract.mjs",
    "module:sign": "node scripts/module-sign.mjs",
    "module:signature-test": "node scripts/test-module-signature.mjs",
    "module:install-auth-test": "node scripts/test-module-install-auth.mjs",
    "module:install-chain-test": "node scripts/test-module-install-chain.mjs",
    "module:db-scope-test": "node scripts/test-module-db-scope.mjs",
    "module:runtime-test": "node scripts/test-module-runtime-policy.mjs",
    "security:body-limit-test": "node scripts/test-http-body-policy.mjs",
    "security:totp-crypto-test": "node scripts/test-totp-secret-crypto.mjs",
    "security:rate-limit-test": "node scripts/test-rate-limit-shared.mjs",
    "security:module-secret-test": "node scripts/test-module-secret.mjs",
    "sandbox:poc": "node scripts/sandbox-poc.mjs",
    "sandbox:rpc-poc": "node scripts/sandbox-rpc-poc.mjs",
    "sandbox:db-poc": "node scripts/sandbox-db-poc.mjs",
    "sandbox:compile-poc": "node scripts/sandbox-compile-poc.mjs",
    "sandbox:f-pilot": "node scripts/sandbox-f-pilot.mjs",
    "version:bump": "node scripts/version.js"
  },
  "keywords": [
    "campus",
    "school",
    "nextjs",
    "firebase",
    "education"
  ],
  "author": "takan003",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takan003/campus-toolkit.git"
  },
  "homepage": "https://github.com/takan003/campus-toolkit#readme",
  "bugs": {
    "url": "https://github.com/takan003/campus-toolkit/issues"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.12",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@grpc/grpc-js": "^1.14.7",
    "rimraf": "^6.1.4",
    "gcp-metadata@8.1.4": {
      "gaxios": "^7.3.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6"
  }
}
